# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: CockroachDB connection string (required for persistence).
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://root@localhost:26257/aora_billing?sslmode=disable"

# SendByte — Transactional email for the waitlist
# Get your API key at https://app.sendbyte.africa
# Use sk_test_... for development, sk_live_... for production
SENDBYTE_API_KEY="sk_test_your_key_here"

# The sender email shown in waitlist confirmation emails.
# Must be a verified domain in your SendByte project.
WAITLIST_FROM="AoraHQ <hello@aorahq.com>"

# ── Zero-trust gateway encryption (REQUIRED in prod) ──────────
# Master key for AES-256-GCM merchant credential encryption.
# Code reads AORAHQ_MASTER_ENCRYPTION_KEY (see encryption-service.ts).
# Generate one with: openssl rand -hex 32 (64 hex chars)
# NOTE: GATEWAY_ENCRYPTION_KEY is legacy — use the name below.
AORAHQ_MASTER_ENCRYPTION_KEY=""

# ── Redis / BullMQ (REQUIRED for multi-instance + webhooks) ──
# Without this, cache falls back to in-memory and webhook/dunning
# workers stay log-only. Fly: fly redis create. Local: redis://localhost:6379
REDIS_URL=""

# ── Authentication (Better Auth) ──────────────────────────────

# Secret for encrypting sessions, signing cookies, and hashing tokens.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Public URL for Better Auth callbacks and redirects.
# In local dev behind a tunnel, set this to the tunnel URL
# (e.g. https://warm-exactly.outray.app).
# In production, MUST be the real domain (e.g. https://app.aorahq.com).
# Falls back to the incoming request's Host header.
# PROD: BETTER_AUTH_URL="https://app.aorahq.com"
BETTER_AUTH_URL="http://localhost:3000"

# API key for Better Auth Cloud dashboard & monitoring.
# Get yours at https://www.better-auth.com/dashboard
BETTER_AUTH_API_KEY=""

# GitHub OAuth app credentials.
# Create an OAuth app at https://github.com/settings/developers
# Callback URL (dev):  http://localhost:3000/api/auth/callback/github
# Callback URL (prod): https://app.aorahq.com/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth app credentials.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://app.aorahq.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Vite (client-side) auth vars ─────────────────────────────
# Exposed to the browser at build time. Public client IDs only —
# never put secrets here. Mirrors of the server vars above, used
# to render the GitHub/Google buttons only when configured.
VITE_AUTH_URL="http://localhost:3000"
VITE_GITHUB_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Comma-separated list of allowed CORS origins for auth.
# Local dev defaults: http://localhost:3000,http://localhost:5173
# PROD: TRUSTED_ORIGINS="https://app.aorahq.com,https://aorahq.com"
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── API subdomain & CORS ─────────────────────────────────────

# Hostname that only serves /api/* — every other path on this host
# returns a JSON 404. Set to "" to serve the SPA on all hosts.
API_HOST="api.aorahq.com"

# Comma-separated allow-list of browser origins that may call the API
# cross-origin (cookies/credentials enabled for these origins).
# Leave empty to allow any origin without credentials — fine for
# Bearer-key (sk_live_...) consumers, which ignore cookies anyway.
# Production example: https://app.aorahq.com,https://aorahq.com
CORS_ORIGINS="https://app.aorahq.com,https://aorahq.com"
